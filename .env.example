# ── Ollama LLM (runs on your RTX 4060 8GB GPU) ────────────────────────────────
# Model options by VRAM cost:
#   phi3:mini           → 2.3 GB  (fast, good quality)
#   mistral:7b-instruct → 4.1 GB  (recommended, best quality for 8GB)
#   llama3:8b-instruct  → 4.7 GB  (slightly better, fits if tight)
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_HOST=http://localhost:11434

# ── Whisper (runs on CPU, keeps GPU free for LLM) ─────────────────────────────
# tiny.en=75MB  base.en=145MB  small=244MB  medium=769MB
WHISPER_MODEL=small

# ── RAG: PubMed abstracts (free via Entrez API) ───────────────────────────────
# NOTE: Only abstracts are free. Full-text papers require institutional access.
# PMC Open Access subset has ~4M free full-text articles.
RAG_INDEX_PATH=data/pubmed_index/faiss_index
ENTREZ_EMAIL=your-email@institution.edu

# ── MLflow (optional — set to false to skip, saves overhead) ──────────────────
ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI=mlflow
